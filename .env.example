# Supabase Configuration
# Dapatkan nilai ini dari Project Settings -> API di dashboard Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Hanya untuk server-side administrative tasks / RPC jika diperlukan)
# JANGAN PERNAH mengekspos key ini ke sisi klien (browser)!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Mayar Sandbox (Fitur Nilai Tambah Pembayaran)
MAYAR_API_KEY=your-mayar-sandbox-api-key
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
